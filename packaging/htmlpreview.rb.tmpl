# ABOUTME: Installs the macOS archive with optional specialist-reader support.
# ABOUTME: Release generation supplies verified archive locations and hashes.
class Htmlpreview < Formula
  desc "Preview local documents and source code in the default browser"
  homepage "https://github.com/tigger-developer/HTML-Preview"
  version {{.Version}}
  license "Apache-2.0"
  depends_on :macos
  # Pandoc is optional for specialist formats such as DOCX.

  if Hardware::CPU.arm?
    url {{.ArmURL}}
    sha256 {{.ArmHash}}
  else
    url {{.IntelURL}}
    sha256 {{.IntelHash}}
  end

  def install
    bin.install "htmlpreview"
    pkgshare.install "LICENSE", "THIRD_PARTY_NOTICES.md", "asap-OFL.txt",
                     "iosevka-custom-OFL.md", "golang-x-net-LICENSE",
                     "bluemonday-LICENSE.md", "douceur-LICENSE", "gorilla-css-LICENSE",
                     "tdewolff-parse-LICENSE.md", "go-yaml-LICENSE", "goldmark-LICENSE",
                     "go-org-LICENSE", "chroma-COPYING", "regexp2-LICENSE",
                     "fsnotify-LICENSE", "golang-x-sys-LICENSE"
    pkgshare.install Dir["share/htmlpreview/*"]
  end

  service do
    run [opt_bin/"htmlpreview", "--serve"]
    keep_alive successful_exit: false
    environment_variables PATH: std_service_path_env
  end

  test do
    assert_match "htmlpreview", shell_output("#{bin}/htmlpreview --version")
  end
end
